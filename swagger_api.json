    "/SchoolOpportunityIndex/schools": {
      "get": {
        "tags": [ "SchoolOpportunityIndex" ],
        "summary": "Get school opportunity index data and quintiles",
        "description": "Returns Opportunity Index metrics, hardship index, and scores. Omit schoolcode to retrieve the full list of CPS schools with schoolName and schoolCode.",
        "parameters": [
          {
            "name": "schoolcode",
            "in": "query",
            "description": "Numeric CPS School ID (e.g., 609749 for Northside Prep, 400009 for Global Citizenship). Omit to fetch all schools.",
            "required": false,
            "schema": {
              "type": "integer",
              "example": 609749
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "schoolCode": {
                        "type": "integer",
                        "example": 400009
                      },
                      "schoolName": {
                        "type": "string",
                        "example": "GLOBAL CITIZENSHIP"
                      },
                      "indicatorSum": { "type": "integer" },
                      "averageScore": { "type": "number" },
                      "communityArea": { "type": "string" }
                    },
                    "additionalProperties": true
                  }
                }
              }
            }
          }
        }
      }
    },
